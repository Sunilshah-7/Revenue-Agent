# Copy this file to `.env` at the repo root before running `npm run infra:local`.
# docker compose reads these automatically for compose.local.yml.
#
# These credentials only authenticate the local Postgres/Redis containers, which
# are bound to 127.0.0.1. They are never used by any hosted deployment.
ARAP_LOCAL_DB_PASSWORD=your-password
ARAP_LOCAL_REDIS_PASSWORD=your-password
