# Hosted deployments must provide a real GROQ_API_KEY and call the real
# Groq API. USE_MOCK_LLM must stay unset/false here — it is a test-only
# escape hatch (see apps/api/.env.local.example) and is never valid in a
# dev or production deployment.
APP_ENV=hosted
NODE_ENV=production
DATABASE_URL=postgresql://...
REDIS_HOST=your-db.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-password
REDIS_TLS=true
USE_MOCK_LLM=false
GROQ_API_KEY=gsk_...
PORT=3001
FRONTEND_URL=http://localhost:3000
