# Local mode rejects non-loopback database and Redis hosts.
APP_ENV=local

# Local pgvector PostgreSQL started by compose.local.yml.
# Password must match ARAP_LOCAL_DB_PASSWORD in the repo-root .env (see .env.example).
DATABASE_URL=postgresql://arap:your-password@127.0.0.1:5432/arap

# Local password-protected Redis started by compose.local.yml.
# Password must match ARAP_LOCAL_REDIS_PASSWORD in the repo-root .env (see .env.example).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-password
REDIS_TLS=false

# Deterministic local responses; no Groq key or network call is used.
# Explicit opt-in only — this is the one place it's set to true. Unset or
# false anywhere else means the real Groq API is called.
USE_MOCK_LLM=true

# Local Bun API and Next.js CORS origin.
PORT=3001
FRONTEND_URL=http://localhost:3000
